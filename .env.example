# Copiar a .env y completar. NO versionar el archivo .env.

# --- Base de datos ---
POSTGRES_DB=shugo_geo
POSTGRES_USER=shugo
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Django ---
DJANGO_SECRET_KEY=generar-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=gestion.ushuaia.gob.ar
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestion.ushuaia.gob.ar
# true si NPM sirve el sitio por HTTPS (recomendado)
DJANGO_SECURE_COOKIES=true

# Duración de la sesión (JWT)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

# Tamaño máximo de documentación adjunta (MB)
DOCUMENTO_MAX_MB=50

# --- Identidad (encabezados de pantallas y reportes) ---
SHUGO_ORGANISMO=Dirección General de Informática
SHUGO_MUNICIPIO=Municipalidad de Ushuaia

# --- Publicación ---
# El frontend no publica puertos: se accede por Nginx Proxy Manager
# (red externa nginx-proxy-manager_npm-net, Forward Hostname: shugo-geo, puerto 80).
